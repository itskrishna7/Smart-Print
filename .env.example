SMARTPRINT_ENV=development

# SmartPrint runtime PostgreSQL connection. Use Neon's pooled URL for the app.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require

# Use Neon's direct, unpooled URL only for schema migrations and data transfer.
DATABASE_URL_UNPOOLED=postgresql://<USER>:<PASSWORD>@<DIRECT_HOST>/<DATABASE>?sslmode=require

# Target allowlists: keep these IDs separate for test and production.
SMARTPRINT_NEON_TEST_PROJECT_ID=<NEON_TEST_PROJECT_ID>
SMARTPRINT_NEON_TEST_BRANCH_ID=<NEON_TEST_BRANCH_ID>
SMARTPRINT_NEON_PRODUCTION_PROJECT_ID=<NEON_PRODUCTION_PROJECT_ID>
SMARTPRINT_NEON_PRODUCTION_BRANCH_ID=<NEON_PRODUCTION_BRANCH_ID>

# Aiven MySQL source settings, retained only for an explicitly run data transfer.
SMARTPRINT_DB_HOST=<AIVEN_HOST>
SMARTPRINT_DB_PORT=3306
SMARTPRINT_DB_USER=<AIVEN_READ_ONLY_USER>
SMARTPRINT_DB_PASSWORD=<AIVEN_READ_ONLY_PASSWORD>
SMARTPRINT_DB_NAME=smart_print
SMARTPRINT_DB_SSL_CA=<PATH_TO_AIVEN_CA_FILE>
